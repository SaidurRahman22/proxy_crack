# Dev defaults: the Django agent is building the API in parallel, so the SPA
# runs against the in-memory mock until the real one is up. Flip
# VITE_USE_MOCK_API to false (or create .env.development.local) to point dev at
# a live backend — no code change required.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCK_API=true
VITE_MOCK_LATENCY_MS=320
