# Base URL of the Django admin API. No trailing slash.
# The app falls back to http://127.0.0.1:8000 when this is unset.
VITE_API_BASE_URL=http://127.0.0.1:8000

# "true" swaps the HTTP transport for an in-memory mock of the admin API
# contract. This is the ONLY switch needed to go from mock to live backend.
VITE_USE_MOCK_API=false

# Artificial latency (ms) applied to mock responses so loading states are real.
VITE_MOCK_LATENCY_MS=320
