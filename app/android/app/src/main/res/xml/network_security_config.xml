<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is OFF by default and allowed only for the development
  hosts below.

  Android 9+ blocks cleartext traffic unless an app opts in. The lazy opt-in
  is `android:usesCleartextTraffic="true"` on <application>, which disables
  the protection for every host the app will ever talk to - including, one
  day, a production API. That is exactly the wrong trade for a product whose
  entire value is not leaking traffic.

  So: the default stays secure, and three development addresses are carved
  out explicitly.

    10.0.2.2    the host machine, as seen from the Android emulator.
                Inside the emulator 127.0.0.1 is the emulator itself.
    10.0.3.2    the Genymotion equivalent.
    localhost   a server running on the device, e.g. adb reverse.

  A LAN address for a physical device (192.168.x.x) is deliberately NOT
  listed. Add it here temporarily if you need it, and do not commit it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
