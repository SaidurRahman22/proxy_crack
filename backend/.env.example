# Proxy Crack backend -- environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Generate a key with:
#   ./.venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Core -----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# DB_ENGINE=sqlite   -> DB_NAME is a filename relative to backend/
# DB_ENGINE=postgres -> the DB_* values below are used
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# DB_ENGINE=postgres
# DB_NAME=proxycrack
# DB_USER=proxycrack
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_CONN_MAX_AGE=60

# --- JWT ------------------------------------------------------------------
# JWT_SIGNING_KEY defaults to DJANGO_SECRET_KEY. Set it separately in
# production so rotating one does not invalidate the other.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- Credential encryption at rest ----------------------------------------
# Encrypts Proxy.username / password / ss_method in the database, so a dump,
# a backup or a read replica does not hand over the paid credentials.
# REQUIRED: a missing or malformed key fails `manage.py check` and the app
# will not start. There is no plaintext fallback.
#
# Generate a key with:
#   ./.venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Comma-separated for rotation -- the FIRST key encrypts, EVERY key is tried
# when decrypting, so rotating needs no downtime:
#   1. deploy with PROXY_CRED_KEY=<new>,<old>   (old rows still readable)
#   2. ./.venv/Scripts/python.exe manage.py rotate_proxy_credentials
#   3. deploy with PROXY_CRED_KEY=<new>         (drop the retired key)
# Production: move key custody to a KMS; see core/crypto.py.
PROXY_CRED_KEY=

# --- API limits -----------------------------------------------------------
API_PAGE_SIZE=25
PASSWORD_MIN_LENGTH=10

# --- Throttles (DRF rate strings, e.g. 60/min, 10/hour) -------------------
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=20/hour
THROTTLE_PROXY_LIST=60/min
# Credentials are the product. Keep this tight.
THROTTLE_PROXY_CREDENTIALS=60/hour
THROTTLE_CHAIN_WRITE=60/hour
THROTTLE_USAGE_REPORT=120/hour
THROTTLE_CONTENT=60/hour

# --- Entitlement fallback -------------------------------------------------
# Applied only when no free Plan row exists, so the API cannot fail open.
FALLBACK_MAX_CHAIN_LENGTH=1
FALLBACK_MAX_DEVICES=1
FALLBACK_BANDWIDTH_LIMIT_BYTES=1073741824

# --- Admin CSV upload -----------------------------------------------------
PROXY_CSV_MAX_BYTES=5242880
PROXY_CSV_MAX_ROWS=50000

# --- Production only ------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Admin API (staff-only, consumed by the React SPA at /api/admin/) -----
# Browser origins allowed to call /api/admin/. Comma-separated and explicit:
# CORS_ALLOW_ALL_ORIGINS is never used here -- the admin API is unscoped, so
# an open origin policy would let any page a logged-in operator visits read
# the whole database with their token.
# CORS is applied only to /api/admin/ (CORS_URLS_REGEX), so the mobile API's
# responses are unchanged.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The SPA sends a Bearer header, not a cookie. Leave this False unless that
# changes -- True plus a wide origin list is the classic CORS foot-gun.
CORS_ALLOW_CREDENTIALS=False
# CORS_URLS_REGEX=^/api/admin/.*$

# Admin throttles. The panel is chatty (a dashboard load is several calls).
THROTTLE_ADMIN=600/min
# Looser than THROTTLE_LOGIN so an operator cannot lock themselves out of
# the panel. Tighten in production; the login endpoint returns an identical
# 403 for every failure, so it gives a brute-forcer no signal either way.
THROTTLE_ADMIN_LOGIN=30/min

# --- Cache (this is a THROTTLING control, not a performance setting) -----
# DRF keeps rate-limit counters in the default cache. With no CACHE_URL the
# project falls back to LocMemCache, which is PER PROCESS: four workers turn
# a 60/hour limit into 240/hour, nothing is shared between hosts, and every
# deploy hands an attacker a fresh budget. Leave blank for a single-process
# dev server; set it for anything else. `manage.py check --deploy` fails
# (core.E002) if this is still blank with DJANGO_DEBUG=False.
CACHE_URL=
# CACHE_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=proxycrack
CACHE_TIMEOUT=300

# --- Admin API throttles --------------------------------------------------
# Graded by what the endpoint can be used to take. The generic read budget
# is loose because dense tables poll; that is only safe because the
# endpoints that matter are not covered by it.
THROTTLE_ADMIN=1200/hour
THROTTLE_ADMIN_WRITE=300/hour
# Login: per IP (all attempts) and per email (FAILURES only, so an operator
# cannot lock themselves out of their own console).
THROTTLE_ADMIN_LOGIN=10/min
THROTTLE_ADMIN_LOGIN_EMAIL=20/hour
THROTTLE_ADMIN_REFRESH=60/hour
# Credential disclosure -- the anti-scrape control for the asset the
# business is built on. Two windows: hourly bounds a burst, daily bounds
# patience. An hourly limit alone is defeated by waiting.
THROTTLE_ADMIN_CREDENTIALS=120/hour
THROTTLE_ADMIN_CREDENTIALS_DAY=400/day
# One bulk call can touch 1000 rows; one upload is minutes of worker time.
THROTTLE_ADMIN_BULK=20/hour
THROTTLE_ADMIN_CSV_UPLOAD=10/hour
# One admin probe run opens up to PROXY_PROBE_API_MAX_IDS outbound
# connections and holds a request worker while they complete. The
# scheduled probe_proxies command is the bulk path.
THROTTLE_ADMIN_PROBE=30/hour

# --- Chain resolution -----------------------------------------------------
# POST /api/chains/{id}/resolve/ turns constrained hops into concrete
# proxies. A client calls it on every connect and on every failover, so the
# budget is looser than a write -- but a constrained hop is a query against
# the inventory, and an unthrottled one is an oracle for enumerating it.
THROTTLE_CHAIN_RESOLVE=120/hour

# --- Proxy health checking ------------------------------------------------
# What a probe does. The prober opens a real connection THROUGH the proxy
# to this target and times the round trip -- not a TCP handshake against
# the proxy's own port, which a dead container answers just as happily.
# Port 443 because many proxies permit CONNECT only to 443, and a probe a
# correctly-configured proxy refuses measures our config, not theirs.
PROXY_PROBE_TARGET_HOST=www.google.com
PROXY_PROBE_TARGET_PORT=443
# Whole-handshake budget, not per socket operation.
PROXY_PROBE_TIMEOUT_SECONDS=10
PROXY_PROBE_CONCURRENCY=8
# Dotted path. Tests override this with proxies.probing.FakeProber; nothing
# in the suite touches a network.
#
# SocketProber speaks all three protocols in D4: SOCKS5, HTTP CONNECT, and
# Shadowsocks AEAD (aes-128-gcm, aes-256-gcm, chacha20-ietf-poly1305) --
# see proxies/shadowsocks.py. Shadowsocks 2022 (`2022-blake3-*`) is a
# different construction and is NOT implemented; those proxies are skipped
# and keep the unprobed score rather than being recorded as dead, because
# a gap in our prober is not a verdict on the proxy.
PROXY_PROBER=proxies.probing.SocketProber

# The rolling window scoring runs over: "the newest N probes, none older
# than D days". Bounded on both axes -- a count alone judges a
# rarely-probed proxy on last quarter's data, an age alone lets one busy
# afternoon swamp the sample.
PROXY_PROBE_WINDOW=50
PROXY_PROBE_WINDOW_DAYS=7

# Retention. ProxyProbe is the only table that grows without a user action:
# 10k proxies at one probe per five minutes is ~2.9M rows a day. Enforced
# by `manage.py prune_probes`, which belongs in the same cron as the probe
# run. MUST be >= PROXY_PROBE_WINDOW_DAYS or pruning deletes the rows
# scoring depends on -- `manage.py check` warns (proxies.W001).
PROXY_PROBE_RETENTION_DAYS=30

# Consecutive failures before a proxy is marked dead. One timeout is noise.
# Asymmetric by design: N failures to die, a single success to revive.
# A proxy that flaps is punished by its success rate instead, which is a
# far better signal than a boolean. Values below 2 are clamped.
PROXY_DEAD_AFTER_FAILURES=3

# Scoring. Reliability multiplies the whole score; latency only ever scales
# it within a band of this width. Above ~0.6 the model inverts and
# fast-but-lossy starts beating reliable-but-slow (proxies.W005).
PROXY_LATENCY_WEIGHT=0.4
# p95 at which the latency factor is exactly 0.5. A curve, not a cliff.
PROXY_LATENCY_HALF_MS=400
# Wilson lower-bound confidence. 1.0, not the textbook 1.96: at 1.96 a
# single successful probe scores 0.21 and would rank below a proxy nobody
# has ever probed, which is perverse.
PROXY_SCORE_CONFIDENCE_Z=1.0
# Score for a proxy with no probes in the window. Mid-scale on purpose:
# below anything proven good, above anything proven bad. Zero would make a
# fresh CSV import unselectable until the first probe run.
PROXY_UNPROBED_SCORE=50.0

# The admin probe endpoint probes synchronously in a request worker, so its
# id list is capped far below the bulk cap of 1000.
PROXY_PROBE_API_MAX_IDS=50

# ---------------------------------------------------------------------------
# Admin audit log (P9)
#
# D12 dropped django.contrib.admin.LogEntry along with Django Admin and
# replaced it with log records only -- readable by any staff account,
# deletable by a superuser, and gone entirely if nobody ships them
# off-host. `adminapi.models.AdminAuditLog` is the durable replacement:
# append-only at the model, the queryset AND a database trigger.
# ---------------------------------------------------------------------------

# What `manage.py prune_audit_log` deletes past. An order of magnitude
# longer than PROXY_PROBE_RETENTION_DAYS (30) and that gap is deliberate:
# probe rows are telemetry, where the newest ones answer every question
# worth asking and the table grows by millions a day. Audit rows are
# evidence, they grow by hundreds a day, and the questions asked of them
# are about the distant past -- usually after an incident makes someone
# look.
ADMIN_AUDIT_RETENTION_DAYS=365

# The floor prune_audit_log refuses to go below, whatever is passed on the
# command line. The realistic threat is not "delete everything" -- that is
# conspicuous -- but "run retention with a small number and call it a
# typo". The database additionally refuses ANY delete inside 30 days, and
# that number is in a migration rather than here, precisely so an
# environment variable cannot move it.
ADMIN_AUDIT_MIN_RETENTION_DAYS=90

# Kill switch for the durable write; the structured log line is emitted
# either way. For a deployment whose database is read-only or wedged,
# where losing the table write beats losing the request. Leave it on.
ADMIN_AUDIT_PERSIST=True

# ---------------------------------------------------------------------------
# IP intelligence and chain diversity scoring (R2)
#
# `proxies.diversity` needs one fact per hop that the inventory does not
# hold: which AS originates the address. Without it a chain whose three
# hops sit in one rack scores the same as one spread across three
# continents -- which is the gap proxychains has and this closes.
# ---------------------------------------------------------------------------

# The source. Default is Team Cymru's DNS-based IP-to-ASN mapping: free,
# no account, no API key. `proxies.intel.IpApiIntel` is an HTTP
# alternative for hosts where outbound DNS to port 53 is blocked -- at the
# cost of the prefix and registry fields, which that source does not
# publish, so the same-/24 check degrades to "unknown" rather than
# answering from a network nobody measured.
IP_INTEL_BACKEND=proxies.intel.CymruDnsIpIntel

# Resolvers for the DNS source, comma-separated. Empty means read
# /etc/resolv.conf; a host without one (Windows) must set this.
#
# There is deliberately NO public-resolver default. These queries are a
# list of your proxy inventory, one host at a time. Handing that list to
# Google or Cloudflare to save a configuration line would be precisely the
# disclosure this product exists to prevent, so the inconvenience is the
# feature. `check --deploy` warns (proxies.W008) when nothing is set.
IP_INTEL_DNS_RESOLVERS=

IP_INTEL_TIMEOUT_SECONDS=5

# How long an answer is trusted. An ASN assignment moves on the order of
# YEARS, so a month of staleness is a far smaller error than querying a
# free service on every page render. Failures expire in hours instead --
# a negative answer cached for a month would mean one DNS outage pinned
# those hosts to "unknown" until next quarter, and "unknown" is the state
# the diversity analysis exists to get out of.
IP_INTEL_TTL_DAYS=30
IP_INTEL_NEGATIVE_TTL_HOURS=6

# Politeness, and the reason lookups are serial rather than threaded.
# `probe_proxies` uses a thread pool because it spends our bandwidth
# against proxies we pay for; this spends somebody else's free service,
# and the cost of exhausting their patience is the whole feature going
# dark with no way to appeal it.
IP_INTEL_RATE_LIMIT_PER_MINUTE=60

# The candidate-evaluation endpoint looks hosts up synchronously in a
# request worker, exactly like the admin probe endpoint. At the default
# rate limit, 25 uncached hosts is already most of a held worker-minute.
# `manage.py refresh_ip_intel` is the bulk path.
IP_INTEL_API_MAX_HOSTS=25

# Chain diversity analysis, mobile. Reads cached intel only and never
# emits a lookup, so it is cheap -- but an ad-hoc analysis takes a list of
# proxy ids, which makes it one more way to ask questions about the
# inventory. Bounded like the resolver, not like a static read.
THROTTLE_CHAIN_DIVERSITY=240/hour

# Operator-triggered IP intel lookups. Tighter than THROTTLE_ADMIN_PROBE
# for the reason above: this one spends a third party's goodwill.
THROTTLE_ADMIN_INTEL=20/hour

# Note: the Five/Nine/Fourteen Eyes and EU bloc map used by the
# jurisdiction check is NOT an environment variable -- it is a dict, and
# `settings.PROXY_JURISDICTION_BLOCS` replaces
# `proxies.jurisdictions.DEFAULT_BLOCS` wholesale. Which groupings matter
# is a political judgement that changes and that reasonable operators
# disagree about, so it is overridable configuration rather than an
# assertion in code -- but it needs a Python literal, not a string.
